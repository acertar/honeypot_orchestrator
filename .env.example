# Honeypot Orchestrator — пример переменных окружения.
# Скопируйте в .env в корне проекта или экспортируйте в systemd-юнит.

# Flask
SECRET_KEY=replace-with-random-64-char-string
FLASK_DEBUG=0
LOG_LEVEL=INFO

# MongoDB
MONGO_URI=mongodb://localhost:27017/honeypot_db
MONGO_DB_NAME=honeypot_db

# Podman (оставьте пустым для автоопределения сокета)
# PODMAN_SOCKET=/run/user/1000/podman/podman.sock
PODMAN_NETWORK=honeypot_network
PODMAN_NETWORK_SUBNET=172.20.0.0/16

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
RABBITMQ_EXCHANGE=honeypot_events
RABBITMQ_QUEUE=honeypot_events_queue

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=replace-with-another-random-string
JWT_ACCESS_TOKEN_EXPIRES=1800
JWT_COOKIE_SECURE=0

# Контуры
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
ADMIN_HOST=127.0.0.1
ADMIN_PORT=5001
DASHBOARD_CORS_ORIGINS=*

# Фоновые сервисы
EVENT_CONSUMER_ENABLED=1
SIEM_FORWARDER_ENABLED=1
LOG_TAILER_ENABLED=1
LOG_TAILER_INTERVAL=2
SIEM_FORWARD_INTERVAL=5
SIEM_BATCH_SIZE=100

# Socket.IO
SOCKETIO_ASYNC_MODE=gevent
